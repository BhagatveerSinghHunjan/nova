# Required — PostgreSQL connection string (local Docker or managed production DB)
# Local example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nova_lab?schema=public"
# Production (Vercel): set this in the Vercel project Environment Variables UI.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nova_lab?schema=public"

# Application
# Local:
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (Vercel): set NODE_ENV via the platform (usually automatic) and
# NEXT_PUBLIC_APP_URL="https://<your-production-domain>"
